{
  "name": "@fayegram-ai/decision-bridge",
  "version": "0.1.3",
  "description": "JavaScript SDK and CLI for structured decisions across native decision APIs and configurable model providers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fayegram-AI/decision-bridge.git"
  },
  "homepage": "https://github.com/Fayegram-AI/decision-bridge",
  "bugs": {
    "url": "https://github.com/Fayegram-AI/decision-bridge/issues"
  },
  "keywords": [
    "decision",
    "bridge",
    "sdk",
    "cli",
    "jev",
    "openai",
    "cloudflare",
    "llm"
  ],
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "browser": "./src/index.mjs",
      "import": "./src/index.mjs"
    },
    "./custom/decision": {
      "types": "./src/custom/decision.d.mts",
      "browser": "./src/custom/decision.mjs",
      "import": "./src/custom/decision.mjs"
    },
    "./custom/generative": {
      "types": "./src/custom/generative/index.d.mts",
      "browser": "./src/custom/generative/index.mjs",
      "import": "./src/custom/generative/index.mjs"
    },
    "./extraction": {
      "types": "./src/extraction/index.d.mts",
      "browser": "./src/extraction/index.mjs",
      "import": "./src/extraction/index.mjs"
    },
    "./live": {
      "types": "./src/live/index.d.mts",
      "browser": "./src/live/index.mjs",
      "import": "./src/live/index.mjs"
    },
    "./config.schema.json": "./schemas/decision.config.schema.json"
  },
  "bin": {
    "decision-bridge": "./bin/decision.mjs",
    "decision": "./bin/decision.mjs",
    "faye-decision": "./bin/decision.mjs"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "verify": "npm run check && npm test && npm run typecheck && npm run test:package",
    "test:package": "node scripts/package-smoke.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "cli": "node bin/decision.mjs",
    "models": "node --env-file-if-exists=.env bin/decision.mjs models",
    "ask": "node --env-file-if-exists=.env bin/decision.mjs evaluate examples/request.json",
    "validate": "node bin/decision.mjs validate examples/request.json",
    "example": "node --env-file-if-exists=.env examples/basic.mjs",
    "example:extended": "node --env-file-if-exists=.env examples/extended.mjs"
  },
  "license": "MIT",
  "files": [
    "src/",
    "bin/",
    "examples/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    ".env.example",
    "schemas/"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "ajv": "8.20.0",
    "typescript": "5.8.3"
  }
}
