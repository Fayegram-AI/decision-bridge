    "$defs": {
        "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
        },
        "keyEnv": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
        },
        "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
        },
        "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
        },
        "tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
        },
        "boolean": {
            "type": "boolean"
        },
        "responseFormat": {
            "enum": [
                "json_schema",
                "json_object",
                "text"
            ]
        },
        "tokenParameter": {
            "enum": [
                "max_completion_tokens",
                "max_tokens"
            ]
        },
        "parameters": {
            "type": "object",
            "properties": {
                "model": false,
                "messages": false,
                "system": false,
                "tools": false,
                "tool_choice": false,
                "toolChoice": false,
                "functions": false,
                "function_call": false,
                "response_format": false,
                "stream": false,
                "stream_options": false,
                "n": false,
                "max_tokens": false,
                "max_completion_tokens": false,
                "headers": false,
                "apiKey": false,
                "api_key": false,
                "baseURL": false,
                "authorization": false
            }
        },
        "options": {
            "type": "object",
            "properties": {
                "apiKey": false,
                "api_key": false
            }
        },
        "gateway": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[\\x20-\\x7e]*\\S[\\x20-\\x7e]*$"
                },
                "cacheKey": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[\\x20-\\x7e]*\\S[\\x20-\\x7e]*$"
                },
                "cacheTtl": {
                    "type": "integer",
                    "minimum": 0
                },
                "skipCache": {
                    "type": "boolean"
                },
                "collectLog": {
                    "type": "boolean"
                },
                "requestTimeoutMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                },
                "metadata": {
                    "type": "object",
                    "propertyNames": {
                        "not": {
                            "pattern": "^cf\\."
                        }
                    },
                    "additionalProperties": {
                        "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                        ]
                    }
                },
                "retries": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "maxAttempts": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "retryDelayMs": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "backoff": {
                            "enum": [
                                "constant",
                                "linear",
                                "exponential"
                            ]
                        }
                    }
                }
            }
        }
    }
