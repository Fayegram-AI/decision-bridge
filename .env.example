# Set only the keys for providers you actually use. Never commit the populated .env.
TYPESAFE_API_KEY=replace_with_your_typesafe_api_key
# JEV_MODEL=jev-latest
# OPENAI_API_KEY=replace_with_your_openai_api_key
# CLOUDFLARE_ACCOUNT_ID=replace_with_your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=replace_with_your_cloudflare_api_token
# Custom generative preset credentials (opt-in custom/generative).
# The OpenAI-compatible preset shares OPENAI_API_KEY at the official OpenAI origin.
# OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
# ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
